{
  "name": "college-admission-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "description": "Enterprise College Admission Management System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "npm run --workspace=packages/database generate",
    "db:migrate": "npm run --workspace=packages/database migrate",
    "db:seed": "npm run --workspace=packages/database seed",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
