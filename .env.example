# ==============================================================================
# COLLEGE ADMISSION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Never commit .env to version control.
# 2. Never place private credentials or database connection strings in NEXT_PUBLIC_* variables.
# 3. For production, generate cryptographically secure 256-bit secrets via:
#      openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SHARED / CORE RUNTIME [Scope: All Services | All Environments]
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api

# ------------------------------------------------------------------------------
# 2. WEB FRONTEND [Scope: apps/web | Production, Preview, Development]
# ------------------------------------------------------------------------------
# Public app branding (exposed to browser bundle)
NEXT_PUBLIC_APP_NAME="Apex Institute of Technology"

# Public API URL used for client-side fetches when not proxied
NEXT_PUBLIC_API_URL=http://localhost:4000/api
WEB_PORT=3000

# Server-side proxy target for Next.js rewrite (/api/:path* -> INTERNAL_API_URL/api/:path*)
# Local: http://localhost:4000 | Production: https://api.yourdomain.com or Vercel service binding
INTERNAL_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 3. DATABASE (PRISMA ORM) [Scope: apps/api, packages/database | All Environments]
# ------------------------------------------------------------------------------
# Local:  mysql://root:password@localhost:3306/admission_db
# Cloud:  mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl={"rejectUnauthorized":true}&connection_limit=10
# Note: For serverless platforms (e.g. Vercel), use connection pooling or limit connection pool.
DATABASE_URL=mysql://USERNAME:PASSWORD@localhost:3306/admission_db

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & SESSION STORE [Scope: apps/api | All Environments]
# ------------------------------------------------------------------------------
# Preferred for Cloud (Upstash, Redis Cloud, AWS ElastiCache):
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT
REDIS_URL=
REDIS_TLS=false

# Fallback host/port configuration (Used for local Docker Compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. JWT & AUTHENTICATION SECRETS [Scope: apps/api | All Environments]
# ------------------------------------------------------------------------------
# MUST be distinct, at least 32 characters each. Generate using: openssl rand -hex 32
JWT_SECRET=super_secret_admission_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_admission_refresh_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 6. S3 / OBJECT STORAGE [Scope: apps/api | Production, Preview, Development]
# ------------------------------------------------------------------------------
# Local MinIO or Cloud AWS S3 / Cloudflare R2
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=admission-documents
S3_BUCKET_RECEIPTS=admission-receipts

# ------------------------------------------------------------------------------
# 7. SECURITY, RATE LIMITING & PROXY [Scope: apps/api | All Environments]
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Local: http://localhost:3000 | Prod: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Global Rate Limiting (Requests per TTL window)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Trust Proxy: 1 (single reverse proxy/Vercel/Cloudflare) or CIDR block. Required in production.
TRUST_PROXY=1

# OTP Provider: 'log' (development mock logger) or 'twilio' / 'msg91' for SMS gateway
OTP_PROVIDER=log

# OpenAPI / Swagger Docs: set to 'true' to force-enable in production, or 'false' to disable
ENABLE_SWAGGER=false
