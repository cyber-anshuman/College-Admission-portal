# ==========================================
# COLLEGE ADMISSION SYSTEM - ENVIRONMENT CONFIG
# ==========================================

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api

# Web Frontend
NEXT_PUBLIC_APP_NAME="Apex Institute of Technology"
NEXT_PUBLIC_API_URL=http://localhost:4000/api
WEB_PORT=3000

# MySQL Database (Prisma)
DATABASE_URL=mysql://USERNAME:PASSWORD@localhost:3306/admission_db


# Redis Cache & BullMQ Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Generate strong 256-bit keys for production)
JWT_SECRET=super_secret_admission_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_admission_refresh_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO Private Document Storage
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=admission-documents
S3_BUCKET_RECEIPTS=admission-receipts

# Security & Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
CORS_ORIGIN=http://localhost:3000

# Proxy & Routing Configuration
INTERNAL_API_URL=http://localhost:4000
TRUST_PROXY=1
OTP_PROVIDER=log
ENABLE_SWAGGER=false

